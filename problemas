For example:

A -> 1
B -> 2
C -> 3
...
Z -> 26
AA -> 27
AB -> 28 
...


class Solution {
public:
    int titleToNumber(string columnTitle) {
        int res =0;
        for (int i =0; i<columnTitle.length();i++){
            res=res*26;
            char c = columnTitle[i];
            int num = (int) c;
            res = res + (num-64);
        }
        return res;
        
    }
};

