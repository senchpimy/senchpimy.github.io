Example 1:

Input: nums = [1,2,3,1], k = 3
Output: true

Example 2:

Input: nums = [1,0,1,1], k = 1
Output: true

Example 3:

Input: nums = [1,2,3,1,2,3], k = 2
Output: false



class Solution {
public:
    bool containsNearbyDuplicate(vector<int>& nums, int k) {
        map <int, int> m;
        for (int i{0}; i<nums.size();i++){
            int ele = nums[i];
            if (m.contains(ele)){
                if (abs(m[ele] - i) <=k)
                    return true;
            }
            m[ele]=i;
        }
        return false;
    }
};

